# Database (RDS — prod uses SSM; this file is for local dev only)
DB_HOST=
DB_NAME=
DB_USER=
DB_PASSWORD=

# Or use a single connection string
# DATABASE_URL=postgresql://user:password@host/reportflow

# Frontend — Vite-visible (bundled into the client)
# Dev: http://localhost:3001/api/trpc (Express mount path)
# Prod: https://<id>.execute-api.sa-east-1.amazonaws.com/prod (API Gateway URL)
VITE_API_URL=
VITE_CLERK_PUBLISHABLE_KEY=

# Backend Clerk — prod reads these from SSM at /reportflow/api/${env}/*
# CLERK_JWT_KEY is the PEM public key from Clerk Dashboard → API Keys
# CLERK_WEBHOOK_SECRET is the signing secret from Clerk Dashboard → Webhooks
CLERK_JWT_KEY=
CLERK_WEBHOOK_SECRET=
# Comma-separated origins allowed to present Clerk tokens (verifyToken's
# authorizedParties). Unset falls back to http://localhost:5173 (Vite dev).
APP_ORIGINS=
# POC extraction (poc/) — Gemini
GOOGLE_API_KEY=
