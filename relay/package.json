{
  "name": "reportflow-relay",
  "version": "1.0.0",
  "description": "ReportFlow outbound relay Lambda (non-VPC). Channel-routed; the `ai` channel owns the per-provider adapter registry.",
  "type": "module",
  "private": true,
  "scripts": {
    "check": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix --max-warnings 0",
    "test": "vitest run",
    "test:watch": "vitest",
    "validate": "pnpm check && pnpm lint && pnpm test"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1114.0",
    "@aws-sdk/client-ssm": "^3.1114.0",
    "@google/genai": "^2.18.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@types/aws-lambda": "^8.10.160",
    "@types/node": "^24.7.0",
    "esbuild": "^0.25.0",
    "eslint": "^9.39.2",
    "globals": "^16.1.0",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.54.0",
    "vitest": "^2.1.9"
  },
  "packageManager": "pnpm@10.4.1"
}
